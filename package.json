{
  "name": "easymidia-clip",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @easymidia/web",
    "dev:api": "npm run dev -w @easymidia/api",
    "dev:worker": "npm run dev -w @easymidia/worker",
    "build": "npm run build -w @easymidia/shared -w @easymidia/api -w @easymidia/worker -w @easymidia/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "pg": "^8.23.0"
  }
}
