# Supabase (etapa 2 do guia de setup)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (etapa 3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=easymidia-clips
R2_PUBLIC_URL=https://clips.easymidia.io

# Upstash Redis (etapa 4)
UPSTASH_REDIS_URL=

# APIs (etapas 7-9)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_DATA_API_KEY=

# Stripe (etapa 11 — test mode serve para desenvolver)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs dos preços (Stripe → Products): starter R$47, pro R$97, agency R$297
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8787
API_BASE_URL=http://localhost:8787
PORT=8787

# Worker (opcional): cookies de conta Google descartável para o yt-dlp (revisão C4)
YTDLP_COOKIES_FILE=

# Worker (opcional): CSV de filas deste worker (vazio = todas). Split C4:
# PC roda transcribe,render; Railway roda o resto + cleanup-r2
WORKER_QUEUES=

# Worker (opcional): alerta de falha definitiva via Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Worker (opcional): geracao de avatares via Gemini image (Google AI Studio)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Worker (opcional): anima as expressoes do avatar em loops de video (fal.ai)
FAL_KEY=
FAL_I2V_MODEL=fal-ai/wan-i2v
